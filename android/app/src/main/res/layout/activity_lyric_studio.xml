<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="LYRIC STUDIO"
                android:fontFamily="@font/ndot57"
                app:fontFamily="@font/ndot57"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:letterSpacing="0.08"
                android:paddingStart="8dp" />
        </LinearLayout>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="48dp">

            <!-- Hero Glass Matrix Card -->
            <FrameLayout
                android:id="@+id/heroTeleprompterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GLYPH MATRIX"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textColor="#EA3323"
                            android:textSize="11sp"
                            android:letterSpacing="0.08" />

                        <com.example.odysseyglyph.CipherTextView
                            android:id="@+id/cipherTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Choose a song"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:id="@+id/tvDecryptedSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lyrics will render live on the rear matrix."
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Smoked Glass 25x25 LED Lens Mirror -->
                    <com.example.odysseyglyph.GlyphMatrixMirrorView
                        android:id="@+id/teleprompterMatrixMirror"
                        android:layout_width="92dp"
                        android:layout_height="92dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Search Bar Pill -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_glass_pill"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="#888888" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Search songs with synced lyrics…"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:textSize="14sp"
                        android:fontFamily="@font/jetbrains_mono"
                        android:paddingStart="12dp"
                        android:singleLine="true" />
                </LinearLayout>
            </FrameLayout>

            <!-- Search Results Container -->
            <LinearLayout
                android:id="@+id/resultsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp" />

            <!-- Starting Deck / Sample Synced Tracks & Import (Visible when empty) -->
            <LinearLayout
                android:id="@+id/startingDeckContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="SUGGESTED TRACKS"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/btnImportLrc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ IMPORT .LRC"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_glass_pill" />
                </LinearLayout>

                <!-- Sample Card 1: Starboy -->
                <FrameLayout
                    android:id="@+id/cardSampleStarboy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Starboy"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="The Weeknd • Synced 3:50"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOAD"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/bg_glass_pill" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Sample Card 2: Bohemian Rhapsody -->
                <FrameLayout
                    android:id="@+id/cardSampleQueen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bohemian Rhapsody"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Queen • Synced 5:55"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOAD"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/bg_glass_pill" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Sample Card 3: Never Gonna Give You Up -->
                <FrameLayout
                    android:id="@+id/cardSampleRick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Never Gonna Give You Up"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rick Astley • Synced 3:33"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOAD"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/bg_glass_pill" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Hidden legacy preview card kept for binding compatibility -->
            <FrameLayout
                android:id="@+id/previewCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <com.example.odysseyglyph.CenteredImageView
                    android:id="@+id/previewImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- Editor Panel (Visible once song is chosen) -->
            <LinearLayout
                android:id="@+id/editorPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Waveform Timeline Glass Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="20dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Timeline"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTrimTimes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0s – 20.0s"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLyricPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Drag scrubber to adjust lyric window"
                        android:textColor="#5A5A62"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Liquid Frosted Waveform Scrubber -->
                    <com.example.odysseyglyph.TactileWaveformScrubberView
                        android:id="@+id/waveformScrubber"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/rangeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:thumbColor="#EA3323"
                        app:trackColorActive="#EA3323"
                        app:trackColorInactive="#262626"
                        app:tickVisible="false" />
                </LinearLayout>

                <!-- Typography & Style Glass Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="20dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Typeface"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <com.example.odysseyglyph.LiquidGlassSegmentedBar
                        android:id="@+id/toggleTypography"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Motion"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <com.example.odysseyglyph.LiquidGlassSegmentedBar
                        android:id="@+id/toggleAnimation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />
                </LinearLayout>

                <!-- Audio Attachment Card -->
                <LinearLayout
                    android:id="@+id/audioCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="20dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvAudioStatus"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Local audio file"
                            android:textColor="#888888"
                            android:textSize="13sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAudio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAttachAudio"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Choose audio (.mp3, .flac)"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        app:strokeColor="#24FFFFFF"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Hardware Slot Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:hint="Save to Slot"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/slotSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/jetbrains_mono"
                        app:simpleItems="@array/save_slots" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRender"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Render to Glyph"
                    android:fontFamily="@font/jetbrains_mono"
                    app:cornerRadius="16dp"
                    android:backgroundTint="#EA3323"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Cancel"
                    app:cornerRadius="12dp"
                    android:textColor="#EA3323"
                    app:strokeColor="#EA3323"
                    android:visibility="gone"
                    android:layout_marginTop="8dp" />

                <com.example.odysseyglyph.GlyphProgressView
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginVertical="12dp"
                    android:visibility="gone" />

                <!-- Success Actions -->
                <LinearLayout
                    android:id="@+id/successActionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenGallerySuccess"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Vault"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#24FFFFFF"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenManager"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="GLYPH HUB"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#24FFFFFF"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Global Liquid Glass Navigation Dock (Console | Lyrics | Studio | Vault) -->
    <include layout="@layout/layout_odyssey_nav_dock" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
