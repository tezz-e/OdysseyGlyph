<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvOptionsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_geist"
        android:textStyle="bold"
        android:text="PRESET OPTIONS"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:letterSpacing="0.02" />

    <TextView
        android:id="@+id/tvOptionsBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MEDIA PRESET // 25×25 LED MATRIX"
        android:fontFamily="@font/font_geist"
        android:textStyle="bold"
        android:textSize="10sp"
        android:textColor="#EA3323"
        android:letterSpacing="0.06"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_preview_well"
        android:padding="12dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:id="@+id/ivLargePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ASSIGN TO TOY SLOT"
        android:fontFamily="@font/font_geist"
        android:textStyle="bold"
        android:textColor="#888888"
        android:textSize="11sp"
        android:letterSpacing="0.06"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSlot1"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="SLOT 1"
            android:textColor="#FFFFFF"
            app:strokeColor="#22FFFFFF"
            app:cornerRadius="12dp"
            android:fontFamily="@font/font_geist"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.04" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSlot2"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="SLOT 2"
            android:textColor="#FFFFFF"
            app:strokeColor="#22FFFFFF"
            app:cornerRadius="12dp"
            android:fontFamily="@font/font_geist"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.04" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSlot3"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="SLOT 3"
            android:textColor="#FFFFFF"
            app:strokeColor="#22FFFFFF"
            app:cornerRadius="12dp"
            android:fontFamily="@font/font_geist"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShare"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="SHARE PRESET (.ODYSSEY)"
        android:textColor="#FFFFFF"
        app:backgroundTint="#EA3323"
        app:cornerRadius="25dp"
        android:fontFamily="@font/font_geist"
        android:textStyle="bold"
        android:textSize="13sp"
        android:letterSpacing="0.04"
        android:layout_marginBottom="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDelete"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="DELETE PRESET"
        android:textColor="#EA3323"
        app:strokeColor="#44EA3323"
        app:cornerRadius="23dp"
        android:fontFamily="@font/font_geist"
        android:textStyle="bold"
        android:textSize="12sp"
        android:letterSpacing="0.04" />

</LinearLayout>
