<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- APP BAR / TOOLBAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUICK SIGNAL"
                    android:fontFamily="@font/ndot57"
                    app:fontFamily="@font/ndot57"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIRECT REAR MATRIX"
                    android:fontFamily="@font/font_geist"
                    app:fontFamily="@font/font_geist"
                    android:textStyle="bold"
                    android:textColor="#EA3323"
                    android:textSize="10sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- MATRIX PREVIEW CARD (RED/BLACK GLASS SUBSTRATE) -->
            <LinearLayout
                android:id="@+id/previewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/signalStatusDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_indicator_dot"
                        android:backgroundTint="#888888" />

                    <TextView
                        android:id="@+id/tvSignalStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="LIVE 25×25 PREVIEW"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textColor="#CCCCCC"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSignalCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_pill_selected"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Centered 25x25 Glyph Matrix Mirror View -->
                <com.example.odysseyglyph.GlyphMatrixMirrorView
                    android:id="@+id/matrixMirror"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginVertical="14dp" />

                <TextView
                    android:id="@+id/tvSignalModeDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stationary 25×25 Display"
                    android:fontFamily="@font/font_geist"
                    app:fontFamily="@font/font_geist"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <!-- INPUT FIELD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="SIGNAL TEXT"
                android:fontFamily="@font/font_geist"
                app:fontFamily="@font/font_geist"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="#0D0D11"
                app:boxStrokeColor="#EA3323"
                app:boxStrokeWidth="1.2dp"
                app:boxStrokeWidthFocused="1.8dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:counterEnabled="true"
                app:counterMaxLength="30"
                app:counterTextColor="@color/colorOnSurfaceVariant"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSignalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. WAIT, BRB, CALL ME, ♥"
                    android:fontFamily="@font/font_geist"
                    app:fontFamily="@font/font_geist"
                    android:textStyle="bold"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:text="WAIT"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#444444"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CURATED SYMBOLS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="LEGIBLE SYMBOLS (25×25 TUNED)"
                android:fontFamily="@font/font_geist"
                app:fontFamily="@font/font_geist"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/symbolsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- PRESETS / RECENTS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="QUICK PRESETS"
                android:fontFamily="@font/font_geist"
                app:fontFamily="@font/font_geist"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/presetsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- FONT TYPOGRAPHY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="FONT TYPOGRAPHY"
                android:fontFamily="@font/font_geist"
                app:fontFamily="@font/font_geist"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <com.example.odysseyglyph.LiquidGlassSegmentedBar
                android:id="@+id/fontSegmentedBar"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <!-- DURATION SELECTOR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="SIGNAL DURATION"
                android:fontFamily="@font/font_geist"
                app:fontFamily="@font/font_geist"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <com.example.odysseyglyph.LiquidGlassSegmentedBar
                android:id="@+id/durationSegmentedBar"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <!-- ACTION BUTTON (NOTHING RED / BLACK MIX STADIUM) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSignal"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="14dp"
                android:backgroundTint="#EA3323"
                android:fontFamily="@font/font_geist"
                app:fontFamily="@font/font_geist"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:text="SHOW SIGNAL"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:strokeColor="#FF6655"
                app:strokeWidth="1dp"
                app:cornerRadius="100dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
