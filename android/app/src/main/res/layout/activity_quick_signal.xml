<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="QUICK SIGNAL"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- MATRIX PREVIEW CARD -->
            <LinearLayout
                android:id="@+id/previewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/signalStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_indicator_dot"
                        android:backgroundTint="#888888" />

                    <TextView
                        android:id="@+id/tvSignalStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="LIVE 25×25 PREVIEW"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSignalCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#EA3323"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Centered 25x25 Glyph Matrix Mirror View -->
                <com.example.odysseyglyph.GlyphMatrixMirrorView
                    android:id="@+id/matrixMirror"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginVertical="16dp" />

                <TextView
                    android:id="@+id/tvSignalModeDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stationary 25×25 Display"
                    android:textColor="#666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- INPUT FIELD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:text="SIGNAL TEXT"
                android:textColor="#888888"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="#08080A"
                app:boxStrokeColor="#333333"
                app:boxStrokeWidth="1dp"
                app:counterEnabled="true"
                app:counterMaxLength="30"
                app:counterTextColor="@color/colorOnSurfaceVariant"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSignalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. WAIT, BRB, CALL ME, ♥"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:text="WAIT"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CURATED SYMBOLS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="LEGIBLE SYMBOLS (25×25 TUNED)"
                android:textColor="#888888"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/symbolsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- PRESETS / RECENTS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="QUICK PRESETS"
                android:textColor="#888888"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/presetsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- FONT TYPOGRAPHY (LIVE LYRICS ENGINE) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="FONT TYPOGRAPHY"
                android:textColor="#888888"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <com.example.odysseyglyph.LiquidGlassSegmentedBar
                android:id="@+id/fontSegmentedBar"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <!-- DURATION SELECTOR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:text="SIGNAL DURATION"
                android:textColor="#888888"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <com.example.odysseyglyph.LiquidGlassSegmentedBar
                android:id="@+id/durationSegmentedBar"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <!-- ACTION BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSignal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#FFFFFF"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="SHOW SIGNAL"
                android:textColor="#000000"
                android:textSize="14sp"
                app:cornerRadius="100dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
