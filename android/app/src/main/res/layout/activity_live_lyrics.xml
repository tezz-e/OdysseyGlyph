<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="7dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE LYRICS"
                    android:fontFamily="@font/ndot57"
                    app:fontFamily="@font/ndot57"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvMasterState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STANDBY"
                    android:fontFamily="@font/font_geist"
                    app:fontFamily="@font/font_geist"
                    android:textStyle="bold"
                    android:textColor="#AAAAAA"
                    android:textSize="10sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchMaster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Toggle Live Lyrics Engine" />
        </LinearLayout>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <!-- Hero Telemetry Single-Row Strip -->
            <FrameLayout
                android:id="@+id/heroTelemetryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Left: Authentic 25x25 Glyph Matrix Mirror -->
                    <com.example.odysseyglyph.GlyphMatrixMirrorView
                        android:id="@+id/liveMatrixMirror"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_gravity="center_vertical" />

                    <!-- Right: Telemetry & Live Track Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:id="@+id/liveStatusDot"
                                android:layout_width="7dp"
                                android:layout_height="7dp"
                                android:layout_marginEnd="7dp"
                                android:background="@drawable/bg_indicator_dot" />

                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting for music"
                                android:fontFamily="@font/font_geist"
                                app:fontFamily="@font/font_geist"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:textSize="14.5sp"
                                android:letterSpacing="0.03" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTrackInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Play a track to begin."
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textColor="#9E9E9E"
                            android:textSize="12.5sp"
                            android:layout_marginTop="3dp"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Permission Disclosure Card -->
                <LinearLayout
                    android:id="@+id/permissionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notification Access"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Required to read track titles and playback timestamps locally. No data leaves your device."
                        android:textColor="#9E9E9E"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textSize="12.5sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPermission"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        app:cornerRadius="22dp"
                        android:backgroundTint="#EA3323"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="12.5sp"
                        android:letterSpacing="0.04"
                        android:text="Enable Access" />
                </LinearLayout>

                <!-- Hidden legacy image view kept for binding -->
                <ImageView
                    android:id="@+id/ivAlbumArt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Engine Configuration Instrument Rack -->
                <LinearLayout
                    android:id="@+id/cardEngineControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <!-- Section 1: Animation Style -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ANIMATION STYLE"
                        android:textColor="#888888"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <com.example.odysseyglyph.LiquidGlassSegmentedBar
                        android:id="@+id/toggleAnimation"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Section 2: Sync Offset Timing -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="SYNC OFFSET"
                            android:textColor="#888888"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tvSyncOffset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0ms (Exact)"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/btnResetSync"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RESET"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textColor="#EA3323"
                            android:textSize="11sp"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_glass_pill" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="-1000.0"
                        android:valueTo="1000.0"
                        android:stepSize="50.0"
                        android:value="0.0"
                        app:thumbColor="#EA3323"
                        app:trackColorActive="#EA3323"
                        app:trackColorInactive="#202024"
                        app:trackHeight="5dp"
                        app:thumbRadius="10dp"
                        app:thumbElevation="0dp"
                        app:haloRadius="20dp"
                        app:haloColor="@android:color/transparent"
                        app:tickVisible="false"
                        app:labelBehavior="gone" />

                    <!-- Hairline Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#14FFFFFF"
                        android:layout_marginVertical="12dp" />

                    <!-- Section 3: Typeface -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TYPEFACE"
                        android:textColor="#888888"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <com.example.odysseyglyph.LiquidGlassSegmentedBar
                        android:id="@+id/toggleTypography"
                        android:layout_width="match_parent"
                        android:layout_height="44dp" />

                    <!-- Hairline Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#14FFFFFF"
                        android:layout_marginVertical="12dp" />

                    <!-- Section 4: Fallback Visualizer -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FALLBACK VISUALIZER"
                                android:textColor="#888888"
                                android:fontFamily="@font/font_geist"
                                app:fontFamily="@font/font_geist"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/tvFallbackDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Animated pattern when lyrics are unavailable."
                                android:fontFamily="@font/font_geist"
                                app:fontFamily="@font/font_geist"
                                android:textColor="#9E9E9E"
                                android:textSize="12sp"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFallback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCustomizeFallback"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="CUSTOMIZE PATTERN"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="12.5sp"
                        android:letterSpacing="0.04"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#14FFFFFF"
                        app:strokeColor="#24FFFFFF"
                        app:strokeWidth="1dp"
                        app:cornerRadius="22dp"
                        app:rippleColor="#20FFFFFF"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <!-- Shortcuts Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenManager"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="GLYPH HUB"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.04"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#14FFFFFF"
                        app:strokeColor="#24FFFFFF"
                        app:strokeWidth="1dp"
                        app:cornerRadius="22dp"
                        app:rippleColor="#20FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddTile"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="QUICK TILE"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.04"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#14FFFFFF"
                        app:strokeColor="#24FFFFFF"
                        app:strokeWidth="1dp"
                        app:cornerRadius="22dp"
                        app:rippleColor="#20FFFFFF" />
                </LinearLayout>

                <!-- Hidden legacy container kept for binding -->
                <LinearLayout
                    android:id="@+id/layoutAlwaysOnMode"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Global Liquid Glass Navigation Dock (Console | Lyrics | Studio | Vault) -->
    <include layout="@layout/layout_odyssey_nav_dock" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
