<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="?android:attr/colorBackground"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:collapsedTitleTextAppearance="@style/TextAppearance.Odyssey.CollapsedTitle"
            app:expandedTitleTextAppearance="@style/TextAppearance.Odyssey.ExpandedTitle"
            app:collapsedTitleTextColor="?attr/colorOnSurface"
            app:expandedTitleTextColor="?attr/colorOnSurface"
            app:title="LIVE LYRICS">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <!-- Master Switch -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RUN IN BACKGROUND"
                android:fontFamily="@font/jetbrains_mono"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:layout_marginBottom="@dimen/spacing_large" />
                
            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Permission Card -->
            <LinearLayout
                android:id="@+id/permissionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorSurfaceVariant"
                android:padding="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_large">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reads what's currently playing locally on your phone — nothing is uploaded."
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="@dimen/spacing_small" />
                    
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantPermission"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cornerRadius="0dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="GRANT PERMISSION" />
            </LinearLayout>

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_large">
                
                <ImageView
                    android:id="@+id/ivAlbumArt"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:scaleType="centerCrop"
                    android:background="#333333"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waiting for media playback…"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary" />
                    
                <TextView
                    android:id="@+id/tvTrackInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Animation Toggle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANIMATION STYLE"
                android:fontFamily="@font/jetbrains_mono"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:layout_marginBottom="@dimen/spacing_small" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleAnimation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:layout_marginBottom="@dimen/spacing_large">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnimFlash"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FLASH"
                    android:fontFamily="@font/jetbrains_mono" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnimHybrid"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HYBRID"
                    android:fontFamily="@font/jetbrains_mono" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnimScroll"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SCROLL"
                    android:fontFamily="@font/jetbrains_mono" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Sync Offset -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUDIO SYNC OFFSET (±1000ms)"
                android:fontFamily="@font/jetbrains_mono"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:layout_marginBottom="4dp" />
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_large">
                
                <TextView
                    android:id="@+id/tvSyncOffset"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="0ms"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textAlignment="center" />
                    
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSync"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:labelStyle="@style/Widget.Odyssey.Tooltip"
                    app:thumbColor="@color/colorOnSurface"
                    app:trackColorActive="@color/colorOnSurface"
                    app:trackColorInactive="@color/colorSurfaceVariant"
                    android:valueFrom="-1000.0"
                    android:valueTo="1000.0"
                    android:stepSize="50.0"
                    android:value="0.0" />
            </LinearLayout>

            <!-- Typography Toggle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TYPOGRAPHY"
                android:fontFamily="@font/jetbrains_mono"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:layout_marginBottom="@dimen/spacing_small" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleTypography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:layout_marginBottom="@dimen/spacing_large">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSmooth"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SMOOTH"
                    android:fontFamily="@font/jetbrains_mono" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlocky"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BLOCKY"
                    android:fontFamily="@font/jetbrains_mono" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPixel"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PIXEL"
                    android:fontFamily="@font/jetbrains_mono" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Fallback Visualizer Toggle -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchFallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FALLBACK VISUALIZER"
                android:fontFamily="@font/jetbrains_mono"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:layout_marginBottom="@dimen/spacing_small" />
                
            <TextView
                android:id="@+id/tvFallbackDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keeps the matrix alive with a dynamic animation when a song is playing but no lyrics are available."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="@dimen/spacing_small" />
                
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomizeFallback"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CUSTOMIZE FALLBACK VISUAL"
                android:fontFamily="@font/jetbrains_mono"
                app:cornerRadius="0dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="@dimen/spacing_large" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenManager"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPEN GLYPH TOYS MANAGER"
                android:fontFamily="@font/jetbrains_mono"
                app:cornerRadius="0dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="@dimen/spacing_large" />
                
            <!-- Always On QS Tile Card -->
            <LinearLayout
                android:id="@+id/layoutAlwaysOnMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorSurfaceVariant"
                android:padding="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_large">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALWAYS ON MODE (OPTIONAL)"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nothing OS enforces a 10-minute maximum timeout on all Glyph Toys. To bypass this and run Live Lyrics indefinitely, use the Quick Settings Tile from your notification dropdown."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="@dimen/spacing_medium" />
                    
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddTile"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cornerRadius="0dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="ADD QUICK SETTINGS TILE" />
            </LinearLayout>
                
            <!-- Static padding for system navigation bar to prevent edge-to-edge clipping bugs -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="100dp" />
            
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
