<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE LYRICS"
                    android:fontFamily="@font/ndot57"
                    app:fontFamily="@font/ndot57"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvMasterState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STANDBY"
                    android:fontFamily="@font/font_geist"
                    app:fontFamily="@font/font_geist"
                    android:textStyle="bold"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchMaster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Toggle Live Lyrics Engine" />
        </LinearLayout>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="48dp">

            <!-- Hero Dual-Lens Card -->
            <FrameLayout
                android:id="@+id/heroTelemetryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Dual Lenses: Left Matrix Mirror, Right Oscilloscope -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <com.example.odysseyglyph.GlyphMatrixMirrorView
                                android:id="@+id/liveMatrixMirror"
                                android:layout_width="92dp"
                                android:layout_height="92dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rear Matrix"
                                android:fontFamily="@font/font_geist"
                                app:fontFamily="@font/font_geist"
                                android:textStyle="bold"
                                android:textColor="#B0B0B0"
                                android:textSize="11sp"
                                android:letterSpacing="0.04"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="90dp"
                            android:background="#222222"
                            android:layout_marginHorizontal="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <com.example.odysseyglyph.OscilloscopeReticleView
                                android:id="@+id/oscilloscopeView"
                                android:layout_width="92dp"
                                android:layout_height="92dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Audio Scope"
                                android:fontFamily="@font/font_geist"
                                app:fontFamily="@font/font_geist"
                                android:textStyle="bold"
                                android:textColor="#B0B0B0"
                                android:textSize="11sp"
                                android:letterSpacing="0.04"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Live Playback Status -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Waiting for music"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tvTrackInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Play a track in Spotify, YouTube Music, or your media player."
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textColor="#A0A0A0"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Permission Disclosure Card -->
                <LinearLayout
                    android:id="@+id/permissionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="20dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notification Access"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Required to read track titles and playback timestamps locally. No data leaves your device."
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPermission"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        app:cornerRadius="12dp"
                        android:backgroundTint="#EA3323"
                        android:textColor="#FFFFFF"
                        android:text="Enable Access" />
                </LinearLayout>

                <!-- Hidden legacy image view kept for binding -->
                <ImageView
                    android:id="@+id/ivAlbumArt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Engine Configuration Instrument Rack -->
                <LinearLayout
                    android:id="@+id/cardEngineControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="20dp"
                    android:layout_marginBottom="14dp">

                    <!-- Section 1: Animation Style -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ANIMATION STYLE"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="10dp" />

                    <com.example.odysseyglyph.LiquidGlassSegmentedBar
                        android:id="@+id/toggleAnimation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="18dp" />

                    <!-- Section 2: Sync Offset Timing -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="SYNC OFFSET"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/tvSyncOffset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0ms (Exact)"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/btnResetSync"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RESET"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textColor="#EA3323"
                            android:textSize="11sp"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_glass_pill" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="-1000.0"
                        android:valueTo="1000.0"
                        android:stepSize="50.0"
                        android:value="0.0"
                        app:thumbColor="#EA3323"
                        app:trackColorActive="#EA3323"
                        app:trackColorInactive="#262626"
                        app:labelStyle="@style/Widget.Odyssey.SliderTooltip" />

                    <!-- Hairline Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#14FFFFFF"
                        android:layout_marginVertical="16dp" />

                    <!-- Section 3: Typeface -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TYPEFACE"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="10dp" />

                    <com.example.odysseyglyph.LiquidGlassSegmentedBar
                        android:id="@+id/toggleTypography"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <!-- Hairline Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#14FFFFFF"
                        android:layout_marginVertical="16dp" />

                    <!-- Section 4: Fallback Visualizer -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FALLBACK VISUALIZER"
                                android:textColor="#FFFFFF"
                                android:fontFamily="@font/font_geist"
                                app:fontFamily="@font/font_geist"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:letterSpacing="0.06" />

                            <TextView
                                android:id="@+id/tvFallbackDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Animated pattern when lyrics are unavailable."
                                android:fontFamily="@font/font_geist"
                                app:fontFamily="@font/font_geist"
                                android:textColor="#B0B0B0"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFallback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCustomizeFallback"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="CUSTOMIZE PATTERN"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:letterSpacing="0.06"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#33FFFFFF"
                        app:cornerRadius="12dp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <!-- Shortcuts Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenManager"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="GLYPH HUB"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:letterSpacing="0.06"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#33FFFFFF"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddTile"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="QUICK TILE"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:letterSpacing="0.06"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#33FFFFFF"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Hidden legacy container kept for binding -->
                <LinearLayout
                    android:id="@+id/layoutAlwaysOnMode"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Global Liquid Glass Navigation Dock (Console | Lyrics | Studio | Vault) -->
    <include layout="@layout/layout_odyssey_nav_dock" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
