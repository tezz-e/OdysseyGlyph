<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <!-- Top App Bar with Monospace Title & Dynamic Pod -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <LinearLayout
                android:id="@+id/layoutHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GLYPH ODYSSEY"
                        android:fontFamily="@font/ndot57"
                        app:fontFamily="@font/ndot57"
                        android:textSize="21sp"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="0.06"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@null" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnHeaderMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    android:contentDescription="Menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#B0B0B0" />
            </LinearLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="#FFFFFF"
                app:title="CROP &amp; TRIM"
                app:titleTextColor="#FFFFFF"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- ======================================================== -->
            <!-- 1. LAUNCHER GROUP: HARDWARE BENTO CONSOLE RACK            -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/launcherGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- BENTO ROW 1: HERO CARD (Live Lyrics + 25x25 LED Mirror) -->
                <FrameLayout
                    android:id="@+id/heroLyricsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Left: Status & Metadata -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:layout_width="7dp"
                                    android:layout_height="7dp"
                                    android:background="@drawable/bg_indicator_dot" />

                                <TextView
                                    android:id="@+id/tvHeroTrackTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:text="Live Lyrics"
                                    android:fontFamily="@font/font_geist"
                                    app:fontFamily="@font/font_geist"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:textColor="#FFFFFF" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvHeroSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Stream synced lyrics directly to the rear matrix."
                                android:fontFamily="@font/font_geist"
                                app:fontFamily="@font/font_geist"
                                android:textSize="12.5sp"
                                android:textColor="#888888" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLaunchLiveLyrics"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginTop="10dp"
                                android:text="OPEN LIVE LYRICS"
                                android:fontFamily="@font/font_geist"
                                app:fontFamily="@font/font_geist"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"
                                android:textSize="12sp"
                                app:cornerRadius="22dp"
                                app:backgroundTint="#FFFFFF"
                                android:textColor="#000000"
                                app:icon="@drawable/ic_audio"
                                app:iconSize="14dp"
                                app:iconTint="#000000" />
                        </LinearLayout>

                        <!-- Right: Real-time 25x25 LED Circular Mirror -->
                        <com.example.odysseyglyph.GlyphMatrixMirrorView
                            android:id="@+id/glyphMatrixMirror"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_gravity="center" />
                    </LinearLayout>
                </FrameLayout>

                <!-- CARD 2: STANDALONE VISUALIZER -->
                <LinearLayout
                    android:id="@+id/cardVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Music Visualizer"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Dedicated audio-reactive patterns"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textSize="12sp"
                            android:textColor="#888888" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLaunchVisualizer"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="PATTERNS"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:textSize="12sp"
                        app:cornerRadius="22dp"
                        app:backgroundTint="#14FFFFFF"
                        app:strokeColor="#24FFFFFF"
                        app:strokeWidth="1dp"
                        android:textColor="#FFFFFF"
                        app:icon="@drawable/ic_audio"
                        app:iconSize="14dp"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>

                <!-- CARD 3: MEDIA IMPORT & PRESETS -->
                <LinearLayout
                    android:id="@+id/cardMediaPipeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Media Import"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Crop video &amp; GIF into 25×25 matrix animations"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textSize="12sp"
                        android:textColor="#888888" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectVideo"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="IMPORT VIDEO"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            android:textSize="12sp"
                            app:cornerRadius="22dp"
                            app:backgroundTint="#14FFFFFF"
                            app:strokeColor="#24FFFFFF"
                            app:strokeWidth="1dp"
                            android:textColor="#FFFFFF"
                            app:icon="@drawable/ic_folder"
                            app:iconSize="14dp"
                            app:iconTint="#FFFFFF" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVaultMain"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:text="PRESETS"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            android:textSize="12sp"
                            app:cornerRadius="22dp"
                            app:backgroundTint="#14FFFFFF"
                            app:strokeColor="#24FFFFFF"
                            app:strokeWidth="1dp"
                            android:textColor="#FFFFFF"
                            app:icon="@drawable/ic_folder"
                            app:iconSize="14dp"
                            app:iconTint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <!-- CARD: QUICK SIGNAL -->
                <LinearLayout
                    android:id="@+id/cardQuickSignal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Quick Signal"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvQuickSignalBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="DIRECT MESSAGE"
                            android:textColor="#CCCCCC"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQuickSignalSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Project short messages (WAIT, BRB, symbols) to the rear matrix"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="3dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLaunchQuickSignal"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="OPEN SIGNAL"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:letterSpacing="0.04"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#FFFFFF"
                            android:textColor="#000000" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearQuickSignalMain"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:text="CLEAR"
                            android:fontFamily="@font/font_geist"
                            app:fontFamily="@font/font_geist"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:letterSpacing="0.04"
                            app:cornerRadius="20dp"
                            android:textColor="#EA3323"
                            app:strokeColor="#EA3323"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- 2. SETTINGS / VIDEO EDITOR PANEL (100% Intact Types)     -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/settingsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Video Preview Bezel -->
                <FrameLayout
                    android:id="@+id/videoCard"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/video_card_height"
                    android:background="@drawable/bg_glass_card"
                    android:padding="6dp"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:id="@+id/videoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#000000">

                        <com.example.odysseyglyph.CenteredVideoView
                            android:id="@+id/videoView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <com.example.odysseyglyph.CenteredImageView
                            android:id="@+id/imageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <!-- Circular Crop Overlay with touch-activated grid & bezel -->
                        <com.example.odysseyglyph.CropOverlayView
                            android:id="@+id/cropOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Trimmer UI -->
                <LinearLayout
                    android:id="@+id/trimmerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_medium"
                    android:layout_marginBottom="@dimen/spacing_medium">

                    <TextView
                        android:id="@+id/tvTrimTimes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TRIM: 0.0s - 0.0s"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="@dimen/spacing_small" />

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/rangeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:trackHeight="4dp"
                        app:thumbRadius="10dp"
                        app:thumbElevation="2dp"
                        app:haloRadius="0dp"
                        app:labelBehavior="gone"
                        app:tickVisible="false" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginBottom="@dimen/spacing_medium"/>

                <!-- Dropdowns -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:hint="PLAYBACK MODE"
                    android:layout_marginBottom="@dimen/spacing_small">
                    
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/modeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        app:simpleItems="@array/playback_modes" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:hint="SAVE TO SLOT"
                    android:layout_marginBottom="@dimen/spacing_large">
                    
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/slotSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        app:simpleItems="@array/save_slots" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginBottom="@dimen/spacing_medium"/>

                <!-- Universal Audio Component -->
                <LinearLayout
                    android:id="@+id/audioCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_medium"
                    android:layout_marginBottom="@dimen/spacing_medium">
                    
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchIncludeAudio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="INCLUDE VIDEO AUDIO"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginBottom="@dimen/spacing_medium"/>

                <!-- Advanced Options Toggle -->
                <LinearLayout
                    android:id="@+id/btnAdvancedToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/spacing_medium"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_large">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="ADVANCED SETTINGS"
                        android:fontFamily="@font/font_geist"
                        app:fontFamily="@font/font_geist"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF" />
                        
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_settings"
                        app:tint="#888888" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 3. BOTTOM ACTION BAR (Sticky Thumb Zone) -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#141414"
        android:layout_gravity="bottom"
        android:visibility="gone"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProcess"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="RENDER TO GLYPH"
            android:fontFamily="@font/ndot57"
            app:fontFamily="@font/ndot57"
            android:letterSpacing="0.1"
            app:cornerRadius="4dp"
            app:backgroundTint="#FFFFFF"
            android:textColor="#000000" />
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CANCEL"
            android:fontFamily="@font/ndot57"
            app:fontFamily="@font/ndot57"
            app:cornerRadius="4dp"
            android:textColor="#FF4444"
            app:strokeColor="#FF4444"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <com.example.odysseyglyph.GlyphProgressView
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginVertical="12dp"
            android:visibility="gone" />
            
        <LinearLayout
            android:id="@+id/successActionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:weightSum="2">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenGallerySuccess"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="OPEN VAULT"
                android:fontFamily="@font/ndot57"
                app:fontFamily="@font/ndot57"
                app:cornerRadius="4dp"
                app:strokeColor="#444444"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenManager"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="GLYPH HUB"
                android:fontFamily="@font/ndot57"
                app:fontFamily="@font/ndot57"
                app:cornerRadius="4dp"
                app:strokeColor="#444444"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
