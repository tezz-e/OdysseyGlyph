<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TITLE"
        android:fontFamily="@font/ndot57"
        app:fontFamily="@font/ndot57"
        android:textSize="18sp"
        android:letterSpacing="0.06"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Message goes here."
        android:fontFamily="@font/font_geist"
        app:fontFamily="@font/font_geist"
        android:textSize="13sp"
        android:textColor="#B0B0B0"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="22dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="CANCEL"
            android:fontFamily="@font/font_geist"
            app:fontFamily="@font/font_geist"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:letterSpacing="0.04"
            android:textColor="#FFFFFF"
            app:backgroundTint="#14FFFFFF"
            app:strokeColor="#24FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="20dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="CONFIRM"
            android:fontFamily="@font/font_geist"
            app:fontFamily="@font/font_geist"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:letterSpacing="0.04"
            android:textColor="#FFFFFF"
            app:backgroundTint="#EA3323"
            app:cornerRadius="20dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
