<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_pixel_card"
    android:padding="24dp">

    <!-- Header badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[NOTHING ACCESS DISCLOSURE]"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textColor="#EA3323"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Media Playback Access"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Glyph Odyssey requires Notification Listener access exclusively to read currently playing music metadata (track title, artist, playback timeline) to render synchronized live lyrics on the rear 25×25 LED matrix.\n\n• Zero personal messages, emails, or personal notifications are read, tracked, or saved.\n• No data ever leaves your device."
        android:textSize="13sp"
        android:textColor="#B0B0B0"
        android:lineSpacingExtra="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnDisclosureDecline"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="CANCEL"
            android:textColor="#888888"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnDisclosureAccept"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="ENABLE ACCESS"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
