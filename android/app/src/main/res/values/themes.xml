<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OdysseyGlyph" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Core Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorTertiary">@color/colorSurfaceVariant</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorError">@color/colorError</item>
        
        <!-- M3 Container Colors (Overrides Default Purple) -->
        <item name="colorPrimaryContainer">@color/colorPrimary</item>
        <item name="colorOnPrimaryContainer">@color/colorBackground</item>
        <item name="colorSecondaryContainer">@color/colorSurfaceVariant</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSurface</item>
        <item name="colorTertiaryContainer">@color/colorSurfaceVariant</item>
        <item name="colorOutline">@color/colorOnSurfaceVariant</item>
        
        <!-- Navigation bar & Status bar (transparent for edge-to-edge) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
        <!-- Shape Overrides (Sharp/Technical) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Odyssey.Sharp</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Odyssey.Sharp</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Odyssey.Sharp</item>
        
        <!-- Default Font (Inter/sans-serif) -->
        <item name="android:fontFamily">sans-serif</item>
        
        <item name="materialSwitchStyle">@style/Widget.Odyssey.MaterialSwitch</item>
    </style>
    
    <style name="Widget.Odyssey.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track_selector</item>
        <item name="thumbTint">@color/switch_thumb_selector</item>
        <item name="thumbIcon">@empty</item>
    </style>
    
    <style name="ShapeAppearance.Odyssey.Sharp" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">2dp</item>
    </style>
    
    <style name="TextAppearance.Odyssey.CollapsedTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/ndot57</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TextAppearance.Odyssey.ExpandedTitle" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/ndot57</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="Widget.Odyssey.Tooltip" parent="Widget.Material3.Tooltip">
        <item name="android:textAppearance">@style/TextAppearance.Odyssey.Tooltip</item>
        <item name="backgroundTint">@color/colorOnSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Odyssey.Sharp</item>
    </style>
    
    <style name="TextAppearance.Odyssey.Tooltip" parent="TextAppearance.Material3.Tooltip">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/colorBackground</item>
    </style>
</resources>
