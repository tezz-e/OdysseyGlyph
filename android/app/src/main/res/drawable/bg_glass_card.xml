<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Pure Neutral Glass Substrate (Achromatic: R == G == B) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08080A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Deepened Specular Hairline Rim (1px, subtle dark outline) -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#0DFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
